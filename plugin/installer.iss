; Falcon Echo Test New 1 — Windows installer (generated by Falcon VST Maker)

#define AppName      "Falcon Echo Test New 1"
#define AppVersion   "1.0.0"
#define Publisher    "Falcon Eye Corporation"
#define PublisherURL "https://www.falconeyesl.com"
#define BuildDir     "K:\VST Build in Maker\FalconEchoTestNew1\build\FalconEchoTestNew1_artefacts\Release"

[Setup]
AppId=FalconMaker-10f7a5d041241f9e
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#Publisher}
AppPublisherURL={#PublisherURL}
AppSupportURL={#PublisherURL}
DefaultDirName={autopf}\{#Publisher}\{#AppName}
DefaultGroupName={#Publisher}
DisableProgramGroupPage=yes
OutputDir=K:\VST Build in Maker\FalconEchoTestNew1\output
OutputBaseFilename=FalconEchoTestNew1-{#AppVersion}-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
UninstallDisplayIcon={app}\{#AppName}.exe
SetupIconFile={#SourcePath}\icon.ico

[Types]
Name: "full";    Description: "Full installation (VST3 + AAX + Standalone)"
Name: "vstonly"; Description: "VST3 plugin only"
Name: "aaxonly"; Description: "AAX plugin only (Pro Tools)"
Name: "custom";  Description: "Custom"; Flags: iscustom

[Components]
Name: "vst3";       Description: "{#AppName} VST3 plugin (Standard DAWs)"; Types: full vstonly custom
Name: "aax";        Description: "{#AppName} AAX plugin (Avid Pro Tools)"; Types: full aaxonly custom
Name: "standalone"; Description: "{#AppName} Standalone application"; Types: full custom

[Files]
Source: "{#BuildDir}\VST3\{#AppName}.vst3\*"; DestDir: "{commoncf64}\VST3\{#AppName}.vst3"; \
    Components: vst3; Flags: recursesubdirs createallsubdirs ignoreversion
Source: "{#BuildDir}\AAX\{#AppName}.aaxplugin\*"; DestDir: "{commoncf64}\Avid\Audio\Plug-Ins\{#AppName}.aaxplugin"; \
    Components: aax; Flags: recursesubdirs createallsubdirs ignoreversion
Source: "{#BuildDir}\Standalone\{#AppName}.exe"; DestDir: "{app}"; \
    Components: standalone; Flags: ignoreversion

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppName}.exe"; Components: standalone
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"

[Run]
Filename: "{app}\{#AppName}.exe"; Description: "Launch {#AppName}"; \
    Components: standalone; Flags: nowait postinstall skipifsilent runasoriginaluser

[UninstallDelete]
Type: dirifempty; Name: "{commoncf64}\VST3\{#AppName}.vst3"
